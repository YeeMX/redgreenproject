MODULE Module1

    !========================================================
    ! HOME POSITION
    !========================================================

    CONST robtarget Home_P:=
    [[294.426577069,-3.238928977,398.626204981],
    [0.017587782,0.720617719,-0.692967834,-0.014012666],
    [-1,-1,2,0],
    [9E+09,9E+09,9E+09,9E+09,9E+09,9E+09]];


    !========================================================
    ! PICK POSITION
    !========================================================

    CONST robtarget Pick_P:=
    [[294.42656998,198.457700497,347.964193384],
    [0.017587783,0.720617677,-0.692967877,-0.014012659],
    [0,0,3,0],
    [9E+09,9E+09,9E+09,9E+09,9E+09,9E+09]];


    !========================================================
    ! RED STACK POSITION
    ! 原来的红色位置
    !========================================================

    CONST robtarget Red_Place_P:=
    [[203.317190624,-239.378192774,203.819803513],
    [0.01758777,0.720617732,-0.692967821,-0.014012625],
    [-1,-1,2,0],
    [9E+09,9E+09,9E+09,9E+09,9E+09,9E+09]];


    !========================================================
    ! GREEN STACK POSITION
    ! 新绿色位置
    ! Position = -320 0 0
    !========================================================

    CONST robtarget Green_Place_P:=
    [[-100,-200,200],
    [0.01758777,0.720617732,-0.692967821,-0.014012625],
    [-1,-1,2,0],
    [9E+09,9E+09,9E+09,9E+09,9E+09,9E+09]];


    !========================================================
    ! MAIN PROGRAM
    !========================================================

    PROC main()

        VAR num i;
        VAR num red_count;
        VAR num green_count;


        !====================================================
        ! INITIALIZATION
        !====================================================

        red_count := 0;
        green_count := 0;

        ! Controller I/O:
        ! to_grasp_signal = Digital Output

        Reset to_grasp_signal;


        ! Go Home
        MoveJ Home_P,
              v100,
              fine,
              EE_tool\WObj:=wobj0;



        !====================================================
        ! SOURCE STACK 1
        !====================================================

        FOR i FROM 0 TO 3 DO

            !-----------------------------------------------
            ! Move to cylinder
            !-----------------------------------------------

            MoveJ Offs(Pick_P,
                       0,
                       0,
                       -50*i),
                  v100,
                  fine,
                  EE_tool\WObj:=wobj0;


            !-----------------------------------------------
            ! Grip
            !-----------------------------------------------

            Set to_grasp_signal;


            !-----------------------------------------------
            ! Wait for color detection
            ! Controller inputs:
            !
            ! red_detect
            ! green_detect
            !-----------------------------------------------

            WaitUntil red_detect = 1 OR
                      green_detect = 1;


            !-----------------------------------------------
            ! Lift cylinder
            !-----------------------------------------------

            MoveJ Home_P,
                  v100,
                  fine,
                  EE_tool\WObj:=wobj0;


            !================================================
            ! RED CYLINDER
            !================================================

            IF red_detect = 1 THEN

                ! Move above red stack
                MoveJ Offs(Red_Place_P,
                           0,
                           0,
                           150 + 50*red_count),
                      v100,
                      fine,
                      EE_tool\WObj:=wobj0;


                ! Move down
                MoveL Offs(Red_Place_P,
                           0,
                           0,
                           50*red_count),
                      v50,
                      fine,
                      EE_tool\WObj:=wobj0;


                ! Release
                Reset to_grasp_signal;


                ! Increase red counter
                red_count := red_count + 1;


            !================================================
            ! GREEN CYLINDER
            !================================================

            ELSEIF green_detect = 1 THEN

                ! Move above green stack
                MoveJ Offs(Green_Place_P,
                           0,
                           0,
                           70 + 50*green_count),
                      v100,
                      fine,
                      EE_tool\WObj:=wobj0;


                ! Move down
                MoveL Offs(Green_Place_P,
                           0,
                           0,
                           50*green_count),
                      v50,
                      fine,
                      EE_tool\WObj:=wobj0;


                ! Release
                Reset to_grasp_signal;

                
                ! Lift tool before returning Home
                MoveL Offs(Green_Place_P,
                           0,
                           0,
                           30 + 50*green_count),
                    v50,
                    fine,
                    EE_tool\WObj:=wobj0;
                
                
                ! Increase green counter
                green_count := green_count + 1;

            ENDIF


            !-----------------------------------------------
            ! Return Home
            !-----------------------------------------------

            MoveJ Home_P,
                  v100,
                  fine,
                  EE_tool\WObj:=wobj0;

        ENDFOR



        !====================================================
        ! SOURCE STACK 2
        !====================================================

        FOR i FROM 0 TO 3 DO

            ! Move to second source
            MoveJ Offs(Pick_P,
                       160,
                       0,
                       -50*i),
                  v100,
                  fine,
                  EE_tool\WObj:=wobj0;


            ! Grip
            Set to_grasp_signal;


            ! Wait for color
            WaitUntil red_detect = 1 OR
                      green_detect = 1;


            ! Lift
            MoveJ Home_P,
                  v100,
                  fine,
                  EE_tool\WObj:=wobj0;


            !================================================
            ! RED
            !================================================

            IF red_detect = 1 THEN

                MoveJ Offs(Red_Place_P,
                           0,
                           0,
                           150 + 50*red_count),
                      v100,
                      fine,
                      EE_tool\WObj:=wobj0;


                MoveL Offs(Red_Place_P,
                           0,
                           0,
                           50*red_count),
                      v50,
                      fine,
                      EE_tool\WObj:=wobj0;


                Reset to_grasp_signal;

                red_count := red_count + 1;


            !================================================
            ! GREEN
            !================================================

            ELSEIF green_detect = 1 THEN

                MoveJ Offs(Green_Place_P,
                           0,
                           0,
                           70 + 50*green_count),
                      v100,
                      fine,
                      EE_tool\WObj:=wobj0;


                MoveL Offs(Green_Place_P,
                           0,
                           0,
                           50*green_count),
                      v50,
                      fine,
                      EE_tool\WObj:=wobj0;
                      
                Reset to_grasp_signal;

                ! Lift tool before returning Home
                MoveL Offs(Green_Place_P,
                           0,
                           0,
                           80 + 50*green_count),
                    v50,
                    fine,
                    EE_tool\WObj:=wobj0;
                
                green_count := green_count + 1;

            ENDIF


            ! Return Home
            MoveJ Home_P,
                  v100,
                  fine,
                  EE_tool\WObj:=wobj0;

        ENDFOR



        !====================================================
        ! SOURCE STACK 3
        !====================================================

        FOR i FROM 0 TO 3 DO

            ! Move to third source
            MoveJ Offs(Pick_P,
                       70,
                       150,
                       -50*i),
                  v100,
                  fine,
                  EE_tool\WObj:=wobj0;


            ! Grip
            Set to_grasp_signal;


            ! Wait for color
            WaitUntil red_detect = 1 OR
                      green_detect = 1;


            ! Lift
            MoveJ Home_P,
                  v100,
                  fine,
                  EE_tool\WObj:=wobj0;


            !================================================
            ! RED
            !================================================

            IF red_detect = 1 THEN

                MoveJ Offs(Red_Place_P,
                           0,
                           0,
                           150 + 50*red_count),
                      v100,
                      fine,
                      EE_tool\WObj:=wobj0;


                MoveL Offs(Red_Place_P,
                           0,
                           0,
                           50*red_count),
                      v50,
                      fine,
                      EE_tool\WObj:=wobj0;


                Reset to_grasp_signal;

                red_count := red_count + 1;


            !================================================
            ! GREEN
            !================================================

            ELSEIF green_detect = 1 THEN

                MoveJ Offs(Green_Place_P,
                           0,
                           0,
                           70 + 50*green_count),
                      v100,
                      fine,
                      EE_tool\WObj:=wobj0;


                MoveL Offs(Green_Place_P,
                           0,
                           0,
                           50*green_count),
                      v50,
                      fine,
                      EE_tool\WObj:=wobj0;


                Reset to_grasp_signal;

                ! Lift tool before returning Home
                MoveL Offs(Green_Place_P,
                           0,
                           0,
                           80 + 50*green_count),
                    v50,
                    fine,
                    EE_tool\WObj:=wobj0;
                
                green_count := green_count + 1;

            ENDIF


            ! Return Home
            MoveJ Home_P,
                  v100,
                  fine,
                  EE_tool\WObj:=wobj0;

        ENDFOR



        !====================================================
        ! FINISH
        !====================================================

        Reset to_grasp_signal;


        MoveJ Home_P,
              v100,
              fine,
              EE_tool\WObj:=wobj0;


        Stop;

    ENDPROC

ENDMODULE